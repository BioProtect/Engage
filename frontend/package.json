{
  "name": "bioprotect-engage",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "simple-git-hooks",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --cache",
    "knip": "knip",
    "test": "vitest",
    "test:coverage": "vitest run --coverage --watch=false",
    "ci": "npm run lint && npm run knip && npm run test -- --run"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^5.17.1",
    "@mui/material": "^5.17.1",
    "ol": "^10.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@eslint-react/eslint-plugin": "^5.30.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jsdom": "^30.1.3",
    "knip": "^6.45.1",
    "nano-staged": "^1.0.2",
    "simple-git-hooks": "^2.14.0",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  },
  "simple-git-hooks": {
    "pre-commit": "cd frontend && npm run ci && npx nano-staged"
  },
  "nano-staged": {
    "*": "eslint --fix --no-warn-ignored"
  }
}
